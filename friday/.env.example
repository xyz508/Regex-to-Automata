# Copy this file to ".env" and fill it in.

# Required. Get one at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# What Friday calls you
FRIDAY_USER_NAME=Boss

# Optional: choose your own passcode (otherwise one is generated and printed at startup)
# FRIDAY_PASSCODE=

# Optional: speed vs smarts. low = fastest (default), medium, high
# FRIDAY_EFFORT=low
